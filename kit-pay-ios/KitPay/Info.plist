<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Kit Pay</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>africa.kit.pay</string>
			<key>CFBundleURLSchemes</key>
			<array><string>kitwallet</string></array>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.finance</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- AGPL-3.0-only corresponding-source offer for the exact shipped build. Empty in Debug and
	     in unsigned builds; the release pipeline sets KIT_CORRESPONDING_SOURCE_URL once the
	     matching tagged source release has actually been published. An empty or non-matching
	     value is rejected by KitLegalURLPolicy and the app says so rather than linking nowhere. -->
	<key>KitCorrespondingSourceURL</key>
	<string>$(KIT_CORRESPONDING_SOURCE_URL)</string>
	<key>NSCameraUsageDescription</key>
	<string>Scan Kit payment codes and share video during Kit calls.</string>
	<key>NSContactsUsageDescription</key>
	<string>Kit Pay securely syncs contact names and phone numbers to show who is on Kit Pay and keep messaging and calls seamless.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to protect payments and private conversations.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Speak during secure Kit voice and video calls.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose photos to share in secure chats or set as your Kit Pay profile photo.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key><false/>
	</dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>africa.kit.pay.ios.communication-replay</string>
		<string>africa.kit.pay.ios.contacts-refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
	<key>UILaunchScreen</key><dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
